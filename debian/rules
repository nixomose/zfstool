#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS := hardening=+all

GO_ARCH_amd64 := amd64
GO_ARCH_arm64 := arm64
GO_ARCH := $(GO_ARCH_$(DEB_HOST_ARCH))

PACKAGE_CGO := 1

%:
	dh $@

override_dh_auto_build:
	GOFLAGS= GOOS=linux GOARCH=$(GO_ARCH) CGO_ENABLED=$(PACKAGE_CGO) \
		go build -trimpath -buildmode=pie \
		-ldflags '-s -w -X github.com/nixomose/zfstool/internal/version.Version=$(DEB_VERSION_UPSTREAM)' \
		-o zfstool ./cmd/zfstool

override_dh_auto_install:
	install -D -m0755 zfstool debian/zfstool/usr/bin/zfstool
	install -D -m0644 deploy/zfstool-agent.service \
		debian/zfstool/usr/lib/systemd/system/zfstool-agent.service
	install -D -m0644 deploy/zfstool.desktop \
		debian/zfstool/usr/share/applications/zfstool.desktop
	set -e; for sz in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do \
		install -D -m0644 deploy/icons/hicolor/$$sz/apps/zfstool.png \
			debian/zfstool/usr/share/icons/hicolor/$$sz/apps/zfstool.png; \
	done
	install -D -m0644 deploy/icons/hicolor/scalable/apps/zfstool.svg \
		debian/zfstool/usr/share/icons/hicolor/scalable/apps/zfstool.svg

override_dh_auto_test:
	@:

# Go is already stripped with -ldflags '-s -w'.
override_dh_strip:
	@:

override_dh_auto_clean:
	rm -f zfstool

# Ubuntu 24.04 / Debian trixie rename glib and gtk to *t64. Older releases
# still ship libglib2.0-0 and libgtk-3-0 (same amd64 SONAME). Drop the hard
# t64 names from shlibdeps so debian/control can OR them with the old names.
override_dh_shlibdeps:
	dh_shlibdeps -- -xlibglib2.0-0t64 -xlibgtk-3-0t64 -xlibgdk-pixbuf-2.0-0t64
