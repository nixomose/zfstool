Package: zfstool
Architecture: any
Depends: ${misc:Depends}, ${shlibs:Depends},
 libglib2.0-0t64 (>= 2.16.0) | libglib2.0-0 (>= 2.16.0),
 libgtk-3-0t64 (>= 3.9.10) | libgtk-3-0 (>= 3.9.10),
